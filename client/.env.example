# Base URL of the Laravel API, including the /api prefix.
# Docker (nginx):     http://localhost:8080/api
# php artisan serve:  http://localhost:8000/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080/api

# Reverb websocket connection (must match the server's REVERB_* values)
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=6001
NEXT_PUBLIC_REVERB_SCHEME=http
